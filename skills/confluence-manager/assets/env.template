# Confluence configuration for confluence-manager
#
# Copy this file to one of:
#   ~/.config/confluence-manager/.env   (user level, recommended)
#   ./.env                              (project level)
# or let the script create the user-level file:
#   python3 scripts/confluence_api.py config init
#
# Keep the file private (chmod 600). It is git-ignored and must never be
# committed or pasted into logs.

# Required: base URL of your self-hosted Confluence instance.
CONFLUENCE_BASE_URL=https://confluence.example.com

# Recommended: personal access token used with bearer auth.
# Generate it in Confluence: Profile > Settings > Personal Access Tokens.
# A PAT is NOT valid as a basic-auth password.
CONFLUENCE_PAT=

# Optional: auto (default), bearer, or basic.
# "auto" tries bearer first, then basic when username and password are set.
CONFLUENCE_AUTH_MODE=auto

# Basic auth only: your Confluence login username and password.
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=

# Optional: request timeout in seconds and retry count for transient errors.
# CONFLUENCE_TIMEOUT=30
# CONFLUENCE_RETRIES=2
